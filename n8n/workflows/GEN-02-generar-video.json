    {
      "parameters": {
        "jsCode": "// Aviso genérico para el dueño: después sale por Telegram y por WhatsApp (los que estén configurados).\n// teclado: [[{ text, callback_data }]] → botones [{ id, titulo }]\nfunction avisoTelegram(texto, teclado) {\n  const botones = teclado ? teclado.flat().map((b) => ({ id: b.callback_data, titulo: b.text })) : null;\n  return [{ json: { texto: String(texto).slice(0, 4000), botones } }];\n}\n\nconst d = $('Dirección pública').first().json;\nif (!d.avisar) return [];\nreturn avisoTelegram('🎬 Vídeo listo' + (d.titulo ? ': ' + d.titulo : '') + '\\n' + d.url).map((x) => ({ json: Object.assign(x.json, { media_url: d.url, media_tipo: 'video' }) }));\n"
      },
      "id": "fd7cb98b-e81b-522f-a103-d1207950bef7",
      "name": "Avisar si toca",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        -250
      ]
    },
    {
      "parameters": {
        "jsCode": "return $('Dirección pública').all().map((it) => ({ json: it.json }));\n"
      },
      "id": "c2ec75a7-fc25-5e94-8293-a9b617b5325f",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "if (!$env.TELEGRAM_BOT_TOKEN || !$env.TELEGRAM_CHAT_ID) return [];\nreturn $input.all().map((it) => {\n  const j = it.json;\n  const texto = String(j.texto);\n  const teclado = j.botones?.length ? { inline_keyboard: [j.botones.map((b) => ({ text: b.titulo, callback_data: b.id }))] } : null;\n  // Si el aviso trae un vídeo o una imagen, se envía como archivo para verlo dentro de Telegram\n  // (Telegram lo descarga de la URL pública; el texto va como pie, con el enlace por si acaso).\n  if (j.media_url && ['video', 'imagen'].includes(j.media_tipo)) {\n    const campo = j.media_tipo === 'video' ? 'video' : 'photo';\n    const cuerpo = { chat_id: $env.TELEGRAM_CHAT_ID, [campo]: j.media_url, caption: texto.slice(0, 1024) };\n    if (campo === 'video') cuerpo.supports_streaming = true;\n    if (teclado) cuerpo.reply_markup = teclado;\n    return { json: { metodo: campo === 'video' ? 'sendVideo' : 'sendPhoto', cuerpo } };\n  }\n  const cuerpo = { chat_id: $env.TELEGRAM_CHAT_ID, text: texto.slice(0, 4000), disable_web_page_preview: true };\n  if (teclado) cuerpo.reply_markup = teclado;\n  return { json: { metodo: 'sendMessage', cuerpo } };\n});\n"
      },
      "id": "dda17152-1a78-5aec-82b9-aebd07df9869",
      "name": "A Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        -340
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/' + ($json.metodo || 'sendMessage') }}",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}"
