      "id": "8e7813f2-c60c-5046-a09e-9f9f438e3c56",
      "name": "Llamada de herramienta",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const i = $input.first().json;\nconst a = String(i.accion || '');\nconst mapa = {\n  resumen: {}, aprobaciones: {}, leads: {}, incidentes: {}, agentes: {},\n  decidir: { id: i.id, decision: i.decision, comentario: i.texto || '' },\n  orden: { texto: i.texto },\n  agente_ejecutar: { agente_id: Number(i.agente_id), input: i.texto },\n  incidente_reintentar: { id: i.id },\n};\nif (a === 'ciclo_contenido') return [{ json: { ruta: 1 } }];\nconst f = String(i.formato || '').toLowerCase();\nif (a === 'generar_imagen') return [{ json: { ruta: 4, tipo: ['portada', 'miniatura'].includes(f) ? f : 'post',\n  formato: ['cuadrado', 'vertical', 'horizontal'].includes(f) ? f : undefined, tema: i.texto } }];\nif (a === 'generar_video') return [{ json: { ruta: 5, prompt: i.texto, formato: f === 'horizontal' ? 'horizontal' : 'vertical', avisar: true, titulo: String(i.texto || '').slice(0, 60) } }];\nif (a === 'producir_videos') return [{ json: { ruta: 8 } }];\nif (a === 'crear_web') return [{ json: { ruta: 6, encargo: i.texto, avisar: true } }];\nif (a === 'crear_negocio') return [{ json: { ruta: 7, texto: i.texto, tipo: f === 'canal' ? 'canal' : 'negocio' } }];\nif (a === 'pausar' || a === 'reanudar') return [{ json: { ruta: 0, cuerpo: { accion: 'piloto', datos: { pausa: a === 'pausar' } } } }];\nif (a === 'publicar_ahora') return [{ json: { ruta: 2 } }];\nif (!(a in mapa)) return [{ json: { ruta: 3, resultado: 'Acción desconocida: ' + a } }];\nreturn [{ json: { ruta: 0, cuerpo: { accion: a, datos: mapa[a] } } }];\n"
      },
      "id": "c89d26d8-b0d0-53f1-adb0-d54f133eb5a6",
      "name": "Enrutar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
