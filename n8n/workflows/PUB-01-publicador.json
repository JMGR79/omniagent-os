    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE piezas SET estado = 'publicando', intentos = intentos + 1, actualizado_en = now()\nWHERE id IN (SELECT id FROM piezas WHERE estado = 'en_cola' AND programado_para <= now()\n             AND NOT EXISTS (SELECT 1 FROM ajustes WHERE clave = 'pausa' AND valor = 'si')\n             ORDER BY programado_para LIMIT 5 FOR UPDATE SKIP LOCKED)\nRETURNING id, canal, formato, brief, hashtags, media_url, intentos, tema,\n  (SELECT m.tipo FROM medios m WHERE m.pieza_id = piezas.id ORDER BY m.creado_en DESC LIMIT 1) AS media_tipo",
        "options": {}
      },
      "id": "f4ac6ed1-6d6b-5d4a-ba89-7f79a51586b9",
      "name": "Reservar piezas",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        220,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "omniPostgres0001",
          "name": "Postgres OmniAgent"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const it of $input.all()) {\n  const p = it.json;\n  if (!p.id) continue;\n  let texto = String(p.brief || '').trim();\n  if (p.hashtags && !texto.includes(String(p.hashtags).trim())) texto += '\\n\\n' + String(p.hashtags).trim();\n  const corta = (t) => { if (t.length <= 280) return t; const c = t.slice(0, 277); return c.slice(0, Math.max(c.lastIndexOf(' '), 200)) + '…'; };\n  let tweets = [];\n  if (p.canal === 'x') {\n    const partes = /hilo/i.test(p.formato || '') ? String(p.brief || '').split(/\\n\\s*-{3,}\\s*\\n/).map((x) => x.trim()).filter(Boolean) : [String(p.brief || '').trim()];\n    if (p.hashtags && partes.length) partes[partes.length - 1] += ' ' + String(p.hashtags).trim();\n    tweets = partes.map(corta);\n    texto = tweets[0];\n  }\n  const media_tipo = p.media_tipo || (p.media_url ? 'imagen' : '');\n  out.push({ json: { id: p.id, canal: p.canal, texto, tweets, media_url: p.media_url || '', media_tipo, tema: p.tema || '' }, pairedItem: it.pairedItem });\n}\nreturn out;\n"
      },
