      "id": "9a86021e-749f-59e6-8574-a3dbb69407dc",
      "name": "Sin publicador",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        750
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Preparar texto').item.json;\nconst j = $json;\nlet error = '';\nif (j.error) error = typeof j.error === 'string' ? j.error : (j.error.message || JSON.stringify(j.error));\nconst idExt = String(j.id || j.post_id || j.data?.id || j.urn || j.result?.message_id || '');\nif (!error && !idExt) error = 'Respuesta sin identificador de publicación: ' + JSON.stringify(j).slice(0, 300);\nconst subflujo = { linkedin: ['LinkedIn', 'PUB-02'], x: ['X', 'PUB-03'], youtube: ['YouTube', 'PUB-04'] }[p.canal];\nif (subflujo && /not active|no está activ|has issues|credential/i.test(error))\n  error = 'Cuenta de ' + subflujo[0] + ' sin conectar: abre ' + subflujo[1] + ' en n8n, conecta la cuenta y pulsa Publish. (' + error.slice(0, 120) + ')';\nlet url = '';\nif (!error) {\n  if (p.canal === 'facebook') url = 'https://www.facebook.com/' + idExt;\n  else if (p.canal === 'x') url = 'https://x.com/i/web/status/' + idExt;\n  else if (p.canal === 'linkedin') url = 'https://www.linkedin.com/feed/update/' + idExt;\n  else if (p.canal === 'youtube') url = 'https://youtube.com/shorts/' + idExt;\n}\nreturn { json: { params: [p.id, String(error).slice(0, 1000), idExt, url] } };\n",
        "mode": "runOnceForEachItem"
      },
      "id": "c2ec75a7-fc25-5e94-8293-a9b617b5325f",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH p AS (\n  UPDATE piezas SET\n    estado = CASE WHEN $2 = '' THEN 'publicada' WHEN $2 LIKE 'El canal % no tiene publicación automática%' THEN 'requiere_video'\n                  WHEN intentos >= 3 THEN 'error' ELSE 'en_cola' END,\n    error = nullif($2, ''),\n    programado_para = CASE WHEN $2 = '' THEN programado_para ELSE now() + interval '30 minutes' END,\n    actualizado_en = now()\n  WHERE id = $1::uuid RETURNING id, canal, estado),\npub AS (INSERT INTO publicaciones (pieza_id, canal, id_externo, url)\n        SELECT id, canal, nullif($3, ''), nullif($4, '') FROM p WHERE $2 = '' RETURNING id),\ninc AS (INSERT INTO incidentes (workflow, workflow_id, nodo, error, intentos)\n        SELECT 'PUB-01 Publicador', 'omniPUB01publica', canal, $2, 3 FROM p WHERE estado = 'error' RETURNING id)\nSELECT (SELECT count(*) FROM pub)::int AS publicadas, (SELECT count(*) FROM inc)::int AS incidentes",
        "options": {
          "queryReplacement": "={{ $json.params }}"
        }
      },
