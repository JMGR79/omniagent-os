    {
      "parameters": {
        "jsCode": "return $input.all().map((it) => ({ json: { error: { message: 'El canal ' + it.json.canal + ' no tiene publicación automática (requiere vídeo o subida manual)' } }, pairedItem: it.pairedItem }));\n"
