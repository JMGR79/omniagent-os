      "id": "3307ff6b-63ac-5a99-b399-abdf984d2b34",
      "name": "Gracias",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        520
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aviso genérico para el dueño: después sale por Telegram y por WhatsApp (los que estén configurados).\n// teclado: [[{ text, callback_data }]] → botones [{ id, titulo }]\nfunction avisoTelegram(texto, teclado) {\n  const botones = teclado ? teclado.flat().map((b) => ({ id: b.callback_data, titulo: b.text })) : null;\n  return [{ json: { texto: String(texto).slice(0, 4000), botones } }];\n}\n\nconst d = $('Limpiar datos').first().json;\nif (!d.valido) return [];\nreturn avisoTelegram('🧲 Nuevo lead desde la web «' + d.web + '»\\n' + [d.nombre, d.email, d.telefono].filter(Boolean).join(' · ') + (d.mensaje ? '\\n\\n«' + d.mensaje.slice(0, 800) + '»' : ''));\n"
      },
      "id": "01fcddf3-4164-5c95-92c9-df29e3d82956",
      "name": "Avisar del lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        680
      ]
    },
    {
      "parameters": {
        "jsCode": "if (!$env.TELEGRAM_BOT_TOKEN || !$env.TELEGRAM_CHAT_ID) return [];\nreturn $input.all().map((it) => {\n  const cuerpo = { chat_id: $env.TELEGRAM_CHAT_ID, text: String(it.json.texto).slice(0, 4000), disable_web_page_preview: true };\n  if (it.json.botones?.length) cuerpo.reply_markup = { inline_keyboard: [it.json.botones.map((b) => ({ text: b.titulo, callback_data: b.id }))] };\n  return { json: { metodo: 'sendMessage', cuerpo } };\n});\n"
      },
      "id": "dda17152-1a78-5aec-82b9-aebd07df9869",
      "name": "A Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        590
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://api.telegram.org/bot' + $env.TELEGRAM_BOT_TOKEN + '/' + ($json.metodo || 'sendMessage') }}",
        "options": {
          "timeout": 60000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.cuerpo) }}"
