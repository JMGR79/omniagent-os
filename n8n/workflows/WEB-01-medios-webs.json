        220,
        600
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO contactos (email, nombre, telefono, origen, notas, score)\nSELECT nullif($1, ''), nullif($2, ''), nullif($3, ''), 'web:' || $4, nullif($5, ''), 40 WHERE $6 = 'si'\nON CONFLICT DO NOTHING RETURNING id",
        "options": {
          "queryReplacement": "={{ [$json.email, $json.nombre, $json.telefono, $json.web, $json.mensaje, $json.valido ? 'si' : 'no'] }}"
        }
      },
