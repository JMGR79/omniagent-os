    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst t = (v, n) => String(v || '').replace(/[<>]/g, '').trim().slice(0, n);\nconst email = t(b.email, 160).toLowerCase();\nconst d = { nombre: t(b.nombre, 120), email: /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email) ? email : '', telefono: t(b.telefono, 30).replace(/[^\\d+]/g, ''),\n  mensaje: t(b.mensaje, 2000), web: t(b.web, 60), spam: !!String(b.empresa_web || '').trim() };\nd.valido = !d.spam && !!(d.email || d.telefono);\nreturn [{ json: d }];\n"
      },
      "id": "194ff500-b34e-5d0a-9649-57beac63db48",
      "name": "Limpiar datos",
      "type": "n8n-nodes-base.code",
